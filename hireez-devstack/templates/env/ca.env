# ez-candidate-agent, api role. Process env; the repo's own .env is also loaded.
# devstack sets API_PORT, NATIVE_AGENT_BACKEND_INTERNAL_URL (local nab, else test2) and,
# when pa runs locally, PROFILE_AGENT_INTERNAL_URL.
ENV=dev
API_HOST=127.0.0.1
# A local database. test2 has no candidateagent schema to share, and local work must not
# write to a shared server. Create it one time and load the schema from a `databases`
# checkout (postgres/candidateagent/flyway/).
CANDIDATE_AGENT_DB_DSN=postgresql://localhost:5432/candidateagent_dev
EZ_BMC_INTERNAL_URL=https://bmcv2internal.test2.hireez.info
EZ_BMC_SERVICE_API_KEY_SM=/secrets/bmcv2/api
EZ_TMBACKEND_INTERNAL_URL=https://tbv2internal.test2.hireez.info
TMBACKEND_API_KEY_SM=/secrets/tmbackend/api
PROFILE_AGENT_INTERNAL_URL=https://profileagentmcp.test2.hireez.info
# Empty = the note context step is off, so a local note writes no candidate memory in test2.
CONTEXT_ENGINE_URL=
