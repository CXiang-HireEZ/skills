# ez-candidate-agent, merge consumer role. It has no port and holds no credentials.
# devstack sets CANDIDATE_AGENT_API_URL (the local ca) and DEVSTACK_MERGE_GROUP, a local
# consumer group, so that this process never joins the group of a deployed consumer.
# The consumer only reads the topic. It applies each merge to the database of the local ca.
ENV=dev
ENABLE_CANDIDATE_MERGE_CONSUMER=true
KAFKA_BOOTSTRAP_SERVERS=kafka-default.test2.hireez.info:9092
# A new group starts at the newest message. Set `earliest` to read the retained messages again.
# KAFKA_AUTO_OFFSET_RESET=earliest
