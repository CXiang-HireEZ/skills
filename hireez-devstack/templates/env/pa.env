# ez-profile-agent (sidecar). Process env; the repo has no local .env.
# devstack adds NATIVE_AGENT_BACKEND_URL when nab runs locally, and drops the
# *_SM lines with `up --memory` (the sidecar then uses its in-memory store).
ENV=dev
MCP_TRANSPORT=streamable-http
MCP_HOST=127.0.0.1
MCP_PORT=8765
FASTMCP_STATELESS_HTTP=true
PROFILE_AGENT_PG_SM=/secrets/db/postgres/profileagent/user/profileagent_w
PROFILE_AGENT_MONGO_SM=/secrets/db/mongo/profile/user/profileagent_profile_w
PROFILE_HISTORY_PG_SM=/secrets/db/postgres/profilehistory/user/profilehistory_w
PROFILE_ENGINE_URL=https://profileengine.test2.hireez.info
APPLICANT_ENGINE_URL=https://applicantengine.test2.hireez.info
TALENT_ENGINE_URL=https://talentenginev2.test2.hireez.info
DATA_ALLIANCE_ENGINE_URL=https://dataallianceengine.test2.hireez.info
